# Zoho Creator Backend Configuration
# Paste your Zoho Creator Custom API URL below:
ZOHO_CUSTOM_API_URL=https://creatorapp.zoho.com/api/v2/YOUR_OWNER_NAME/YOUR_APP_NAME/api/YOUR_CUSTOM_API

# Optional: Zoho OAuth 2.0 Credentials (only required if your Zoho Custom API or File Download requires Zoho OAuth)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CREATOR_BASE_URL=https://creator.zoho.com
